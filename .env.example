# ============================================================================
# OPPSETT: kjor `cp .env.example .env` og fyll inn verdiene under.
# Node auto-laster IKKE .env - dev-scriptene (apps/api, apps/stream,
# apps/framer-agent) laster rot-.env eksplisitt via
# `node --env-file-if-exists=../../.env ...`. Next.js (apps/web) laster .env selv.
# ============================================================================

# ---- Database ----
# Lokalt: Docker-Postgres. Produksjon: Scaleway Managed PostgreSQL
# (Frankrike, EU) — besluttet 09.08.2026, se docs/deploy-plan.md.
# Eier: migrasjoner + seeding. RLS gjelder IKKE for eieren.
DATABASE_URL="postgresql://endwise:endwise@localhost:5432/endwise"
# App-rollen: alt runtime går her. RLS gjelder.
APP_DATABASE_URL="postgresql://endwise_app:endwise_app@localhost:5432/endwise"

# ---- Auth (F1) ----
BETTER_AUTH_SECRET=""          # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# ---- Envelope-crypto for tenant-hemmeligheter (F1-07) ----
# KEK (Key Encryption Key): base64-kodet 32-byte nøkkel. Krypterer forhandler-
# hemmeligheter (bl.a. Quick API-token) med AES-256-GCM envelope. BYOK — nøkkelen
# ligger UTENFOR databasen. Uten denne kan Quick-token verken lagres eller leses.
#   openssl rand -base64 32
ENDWISE_KEK=""

# ---- Quick-integrasjon (F8-01) ----
# SSRF-vern (CWE-918): tillatte domene-suffiks for forhandlerens Quick baseUrl.
# Kommaseparert. Default (uset) = 'quick.no' (→ quick.no + *.quick.no). Utvid kun
# hvis en forhandler har en Quick-instans på et annet domene. IP-adresser,
# localhost, http og ikke-standard porter blokkeres uansett.
QUICK_ALLOWED_HOST_SUFFIXES=""

# ---- Statens vegvesen / Autosys (F2-08) ----
# Oppslag av regnr → merke/modell/EU-frist. BETALT per kall. Uten nøkkel svarer
# ruta PRECONDITION_FAILED i stedet for å gjette — et tomt kjøretøykort er
# ærligere enn oppdiktede data.
VEGVESEN_API_KEY=""

# ---- Eksterne tjenester — plug-and-play, tomme til nøkler finnes ----
RESEND_API_KEY=""              # e-post + 2FA-koder
# ⛔ Domenet MÅ være verifisert i Resend, ellers avvises hver eneste
#    auth-e-post med 403 validation_error. Per 22.08.2026 er BÅDE
#    endwise.no og no-reply.endwise.no verifisert (apex ble lagt til samme
#    dag — før det ga en from-adresse på endwise.no 403).
#    Sjekk med: curl -H "Authorization: Bearer $RESEND_API_KEY" \
#                    https://api.resend.com/domains
#    Lista koden godtar står i RESEND_VERIFISERTE_DOMENER (packages/auth).
RESEND_FROM="Endwise <no-reply@endwise.no>"
TWILIO_ACCOUNT_SID=""          # SMS-OTP
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# ---- Stripe (F5-09 abonnement/entitlements) ----
# Uten disse kjører billing i MOCK-modus (checkout/portal utilgjengelig, men
# plan→entitlements-logikken virker). Webhooken feiler lukket uten webhook-secret.
STRIPE_SECRET_KEY=""            # sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=""        # whsec_… (Stripe → Developers → Webhooks). Signaturverifisering.
# --- Stripe-priser (F5-32). Opprettes av `pnpm stripe:setup` (TEST-modus). ---
# Tre nivåer:
STRIPE_PRICE_START=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
# Valgfrie tillegg (én pris = én modul):
STRIPE_PRICE_ADDON_ERP=""
STRIPE_PRICE_ADDON_WHITE_LABEL=""
STRIPE_PRICE_ADDON_SSO=""
STRIPE_PRICE_ADDON_NYHETSBREV=""
STRIPE_PRICE_ADDON_FINN=""
STRIPE_PRICE_ADDON_SHOP=""
STRIPE_PRICE_ADDON_RAPPORTER=""
STRIPE_PRICE_ADDON_ANALYSE=""
STRIPE_PRICE_ADDON_BETALING=""
STRIPE_PRICE_ADDON_SAMARBEID=""
# ---- AI: Fireworks (F6-13) ----
# Uten nøkkel kjører systemet på en MOCK-provider — alt virker lokalt, men agenten
# er fake. Legg inn nøkkelen, så brukes Fireworks. Ingen kodeendring.
FIREWORKS_API_KEY=""
# Modell-ID-er per ROLLE. Kopier fra Fireworks' modellkatalog (accounts/fireworks/models/<navn>).
# Ingen defaults i kode — en modell vi gjetter på er en modell som ikke finnes.
FIREWORKS_MODEL_FAST=""        # kunde-support, korte svar
FIREWORKS_MODEL_STANDARD=""    # vanlige agentkall
FIREWORKS_MODEL_HARD=""        # planlegging/resonnering
FIREWORKS_MODEL_EMBED=""       # embeddings (pgvector, F6)
FIREWORKS_MODEL_REALTIME=""    # streaming/lav latens

# ---- AI: Mistral (EU) — F14 ----
# PÅKREVD for kunde-support-agenten. Sluttkundens fritekst skal ALDRI til USA.
# Uten denne nøkkelen nekter support-agenten å starte i produksjon (ingen fallback).
MISTRAL_API_KEY=""
# EU-endepunktet. Mistral har OGSÅ et US-endepunkt — det er sperret i kode.
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_MODEL_FAST=""          # kunde-support (må støtte tool calling)
MISTRAL_MODEL_STANDARD=""
MISTRAL_MODEL_HARD=""
MISTRAL_MODEL_EMBED=""
MISTRAL_MODEL_REALTIME=""
MISTRAL_MODEL_MODERATION=""    # scope-gaten (F14-05), f.eks. mistral-moderation-2603

# ---- Vercel-spesifikt (F13 — ikke nødvendig lokalt) ----
FLAGS_SECRET=""
EDGE_CONFIG=""
BLOB_READ_WRITE_TOKEN=""
SENTRY_DSN=""
SENTRY_ORG=""                  # kun for source map-opplasting ved bygg
SENTRY_PROJECT=""
OTEL_SERVICE_NAME="endwise-web"
CRON_SECRET=""

# F1 — web (:3000) proxer /api/auth/* + /trpc/* til apps/api. Default :3001.
API_INTERNAL_URL="http://localhost:3001"
# F6-02 — web (:3000) proxer /stream/* til apps/stream. Default :3002.
STREAM_INTERNAL_URL="http://localhost:3002"

# ---- Kundewidget (F4) ----
# Signeringshemmelighet for kortlevde widget-tokens (HS256). Egen nøkkel anbefales;
# faller tilbake til BETTER_AUTH_SECRET hvis tom. openssl rand -base64 32
WIDGET_TOKEN_SECRET=""

# ---- Framer-plugin (F12, valgfri) ----
# ⚠️ NEXT_PUBLIC_ = SENDES TIL NETTLESEREN. Kun URL-er og offentlige verdier her.
# Legg ALDRI en hemmelighet bak et NEXT_PUBLIC_-prefiks.
NEXT_PUBLIC_FRAMER_AGENT_URL="http://localhost:3003"

# ---- Dev-brytere (settes IKKE i produksjon) ----
# Rate-limit på auth er PÅ i produksjon uansett. Sett til 1 for å teste den lokalt.
AUTH_RATE_LIMIT=""
