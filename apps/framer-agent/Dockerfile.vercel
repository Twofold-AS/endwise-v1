# F0-07 — Vercel Container (Dockerfile.vercel-mønsteret fra TheFold).
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/framer-agent/package.json apps/framer-agent/
RUN pnpm install --frozen-lockfile --filter @endwise/framer-agent...

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/framer-agent/node_modules ./apps/framer-agent/node_modules
COPY . .
WORKDIR /app/apps/framer-agent
EXPOSE 3003
CMD ["node", "--experimental-strip-types", "src/server.ts"]
