{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/drizzle",
      "!docs",
      "!apps/web/public",
      "!packages/ui/src/components/dither-kit",
      "!packages/ui/src/vendor",
      "!packages/ui/src/morph-bot/endwise-blob.js",
      "!packages/ui/src/assets/icons",
      "!packages/ui/src/assets/icons-v2",
      "!packages/ui/src/icons.generated.ts",
      "!packages/ui/src/components/motion",
      "!packages/ui/src/lib/ease.ts",
      "!packages/ui/src/lib/hooks",
      "!ops"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error",
        "noParameterAssign": "error"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "QuestionnaireInput"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
