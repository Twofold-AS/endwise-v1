# Quick CONNECT-proxy (midlertidig egress)
#
# Ubuntu 24.04 · Scaleway DEV1-S PAR1. Ny tynn boks — ikke dump-VM 51.15.245.52.
# SSH: ssh -i ~/.ssh/endwise_scw root@<boks-ip>
#
# Av i appen = fjern QUICK_HTTPS_PROXY i Vercel (kall går da direkte).

# Port Vercel kobler til (offentlig). Auth er PROXY_SECRET, ikke Vercel-IP.
LISTEN_PORT=3128

# Basic Proxy-Authorization. Generer secret: openssl rand -base64 32
PROXY_USER=endwise
PROXY_SECRET=changeme

# Kun brukt av install.sh for SSH/ufw — ikke av proxy-prosessen.
# Sett operator-IPv4/32. Ikke hardkod én person uten variabel.
SSH_ALLOW_FROM=x.x.x.x/32
