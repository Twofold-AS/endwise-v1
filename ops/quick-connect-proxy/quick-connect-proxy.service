[Unit]
Description=Endwise Quick CONNECT-only proxy (q3.quick.no:443)
Documentation=file:///opt/endwise/quick-connect-proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=endwise-proxy
Group=endwise-proxy
EnvironmentFile=/etc/endwise/quick-connect-proxy.env
ExecStart=/usr/bin/node /opt/endwise/quick-connect-proxy/proxy.mjs
Restart=on-failure
RestartSec=2
# Mons 25.08.2026: ingen QUICK_TOKEN på boksen, ingen TLS-terminering.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Access-log = stdout (timestamp, CONNECT-host, status). Journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quick-connect-proxy

[Install]
WantedBy=multi-user.target
