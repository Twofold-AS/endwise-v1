# Quick live-gateway (tynn HTTPS-videresending til q3.quick.no)
#
# Ubuntu 24.04 · Scaleway DEV1-S PAR1. Ny tynn boks — ikke dump-VM 51.15.245.52.
# SSH: ssh -i ~/.ssh/endwise_scw root@<boks-ip>
#
# Av i appen = fjern QUICK_GATEWAY_URL i Vercel (kall går da direkte eller via CONNECT).
# CONNECT (QUICK_HTTPS_PROXY) er en annen sti — kan stå uset.

# HTTPS-lytter. Auth er GATEWAY_SECRET, ikke Vercel-IP (CWE-290).
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8443

# Delt secret Endwise↔gateway. IKKE Quick-token. Generer: openssl rand -base64 32
GATEWAY_SECRET=changeme

# TLS på boksen. install.sh lager selvsignert hvis filene mangler.
# api.endwise.no / Let's Encrypt dokumenteres senere — bind/host holder nå.
TLS_CERT_PATH=/etc/endwise/quick-gateway.crt
TLS_KEY_PATH=/etc/endwise/quick-gateway.key

# Valgfri mTLS (klientsertifikat fra Endwise). Uset = kun delt secret.
# TLS_CLIENT_CA_PATH=/etc/endwise/quick-gateway-client-ca.crt

# Kun brukt av install.sh for SSH/ufw — ikke av gateway-prosessen.
# Sett operator-IPv4/32. Ikke 0.0.0.0/0.
SSH_ALLOW_FROM=x.x.x.x/32
