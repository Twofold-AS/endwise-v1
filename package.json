{
  "name": "endwise",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @endwise/db db:generate",
    "db:migrate": "pnpm --filter @endwise/db db:migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  }
}
