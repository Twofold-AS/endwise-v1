{
  "name": "@endwise/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:grants": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/grants.ts",
    "db:repair-0020": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/repair-0020.ts",
    "db:setup": "pnpm db:repair-0020 && pnpm db:migrate && pnpm db:grants"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
